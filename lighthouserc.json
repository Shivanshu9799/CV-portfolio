{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec tsx scripts/serve.ts 4174",
      "startServerReadyPattern": "Serving",
      "url": ["http://127.0.0.1:4174/", "http://127.0.0.1:4174/experience/"],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop", "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 360, "height": 800, "deviceScaleFactor": 2, "disabled": false }, "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    }
  }
}

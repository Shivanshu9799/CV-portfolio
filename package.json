{
  "name": "gajendra-agrawal-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "gate:private": "tsx scripts/check-private-strings.ts",
    "gate:claims": "tsx scripts/claims-lint.ts",
    "gates": "pnpm gate:private && pnpm gate:claims",
    "cv:pdf": "tsx scripts/build-cv-pdf.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.19.0",
    "@typescript-eslint/parser": "8.19.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "pdf-parse": "1.1.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}

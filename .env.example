# Copy to .env.local for local work. Never commit real values.

# Public URL of the site (no trailing slash). GitHub Pages project site example:
NEXT_PUBLIC_SITE_URL=https://shivanshu9799.github.io/CV-portfolio

# Sub-path when hosted at /<repo>. Leave empty for a custom domain or root hosting.
NEXT_PUBLIC_BASE_PATH=/CV-portfolio

# "true" lets search engines index the site. Default: noindex, nofollow.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" shows unconfirmed items (e.g. EKAM Venture). Preview builds only unless set.
NEXT_PUBLIC_SHOW_UNCONFIRMED=false

# Optional Formspree-style endpoint. Empty = contact form hidden.
NEXT_PUBLIC_FORM_ENDPOINT=

# Contact details as JSON (kept out of the repo). In CI this is a GitHub secret.
# Format: {"phones":[{"number":"+91...","in_original_cv":true}],"emails":["a@b.com"]}
# Locally you can instead keep content/private.local.json (gitignored).
CONTACT_JSON=
